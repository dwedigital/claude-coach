# Coach mechanic — environment variables
# Copy to .env in this directory and fill in the credentials you have.
# All sources are optional — set only what you use.

# --- Strava (via MCP or REST) ---
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# --- Garmin Connect ---
# Also can be stored in ~/.claude/channels/garmin/.env
GARMIN_EMAIL=
GARMIN_PASSWORD=

# --- Eight Sleep ---
EIGHT_SLEEP_EMAIL=
EIGHT_SLEEP_PASSWORD=
EIGHT_SLEEP_CLIENT_ID=
EIGHT_SLEEP_CLIENT_SECRET=
EIGHT_SLEEP_USER_ID=

# --- Renpho scales (legacy account only, not Renpho Health) ---
# Also can be stored in ~/.claude/channels/renpho/.env
RENPHO_EMAIL=
RENPHO_PASSWORD=

# --- Add your own sources here ---
# OURA_TOKEN=
# WHOOP_EMAIL=
# WHOOP_PASSWORD=
