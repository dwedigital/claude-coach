# Dashboard environment variables
# Copy to .env.local and fill in.

# --- Strava API (one-time OAuth — see docs/QUICKSTART.md) ---
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# --- Eight Sleep ---
EIGHT_SLEEP_EMAIL=
EIGHT_SLEEP_PASSWORD=
EIGHT_SLEEP_CLIENT_ID=
EIGHT_SLEEP_CLIENT_SECRET=
EIGHT_SLEEP_USER_ID=

# --- Path to the coach mechanic directory ---
# Set this to the absolute path of your coach/ folder.
# If dashboard/ and coach/ are siblings in the same monorepo (default),
# you can leave this unset — the dashboard will default to ../coach.
COACH_PROJECT_PATH=

# --- Athlete name shown in the dashboard header ---
NEXT_PUBLIC_ATHLETE_NAME=Athlete
